  "fault": {
    "name": "pool-exhaustion",
    "title": "Payments fail: the payments API's database pool runs dry",
    "cause": "a deploy of the payments API with a connection leak (REFUND_CONNECTION=kept): reading a payment's refunds takes a connection from its database pool of 10 and never gives it back, so after about ten refunds the pool is empty, and every request waits 5 s for a connection, then fails with a 500",
    "expected_symptoms": [
      "POST /payments takes about 5 s and fails with a 500: the 5xx share and the p95 latency climb",
      "the payments API logs 'unhandled error' with PoolTimeout: no connection within 5 s",
      "its health check fails: it cannot get a connection either, while PostgreSQL itself is up",
      "the money check passes: a payment that never got a connection was never charged"
    ],
    "expected_money": {
      "during": "passed",
      "after": "passed",
      "quiet": "passed"
    },
    "remedy": "roll the payments API back to REFUND_CONNECTION=returned: its new container starts with a full pool"
  },
