  "fault": {
    "name": "money-unit",
    "title": "Customers charged 100 times the amount: a money-unit bug",
    "cause": "a deploy of the payments API with a money-unit bug (CHARGE_AMOUNT_UNIT=dollars): it reads each payment's amount, already in cents, as dollars and converts it to cents again, so the provider charges every customer 100 times the amount, while our own records keep the right one",
    "expected_symptoms": [
      "the money check fails on payments_match_provider: for each payment since the deploy, the provider charged 100 times our amount",
      "the ledger books what the provider charged, so it agrees with the provider, and the other invariants pass",
      "the payment confirmer logs a conflict for each such payment: the provider charged a different amount than our payment's",
      "the API stays fast and healthy, and its answers show the right amount",
      "refunds send the right amount: a full refund gives back 1% of what was charged",
      "a payment whose answer was lost during the fault stays pending for good: the confirmer refuses the provider's 100 times amount as a conflict"
    ],
    "expected_money": {
      "during": "failed",
      "after": "failed",
      "quiet": "failed"
    },
    "remedy": "roll the payments API back to CHARGE_AMOUNT_UNIT=cents, then refund each customer charged since the deploy what was charged above the amount, at the provider: our API refunds no more than our recorded amount (a write, so it needs approval)"
  },
