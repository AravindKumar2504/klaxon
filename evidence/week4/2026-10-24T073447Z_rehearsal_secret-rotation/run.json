  "fault": {
    "name": "secret-rotation",
    "title": "The books stop catching up: our webhook receiver refuses every webhook",
    "cause": "a deploy of the webhook receiver with a rotated secret the provider does not sign with (WEBHOOK_SECRET_VERSION=v2, while the provider signs with v1): every webhook fails its signature check and is refused with a 400, so no event reaches Kafka, and the provider keeps sending them again, with backoff",
    "expected_symptoms": [
      "the books cannot catch up with the provider: the money check cannot settle, its webhooks not acknowledged",
      "the receiver counts every webhook as bad_signature, and logs 'webhook refused: bad signature'",
      "nothing new is booked or confirmed, and both consumers' lag stays at 0: nothing reaches Kafka",
      "payments whose answer was lost stay pending, so the payments pending over a minute climb",
      "payments and refunds still succeed, and the API stays fast and healthy"
    ],
    "expected_money": {
      "during": "could not run",
      "after": "passed",
      "quiet": "passed"
    },
    "remedy": "roll the webhook receiver back to v1 (or accept both versions until the provider signs with v2): the provider sends every refused webhook again within a minute, and the books catch up"
  },
