  "fault": {
    "name": "pool-exhaustion",
    "title": "Payments fail: the payments API's database pool runs dry",
    "cause": "a deploy of the payments API with a connection leak (REFUND_CONNECTION=kept): reading a payment's refunds takes a connection from its database pool of 10 and never gives it back, so after about ten refunds the pool is empty, and every request waits for a connection until the pool's 5 s timeout, then fails with a 500",
    "expected_symptoms": [
      "the pool runs dry about 40 to 50 s after the deploy; then POST /payments takes 5 to 8 s (a worker thread, then the pool's 5 s wait) and fails with a 500: the p95 latency passes 7 s, and the 5xx share passes 70% within a minute",
      "the payments API logs 'unhandled error' with PoolTimeout: no connection within 5 s",
      "its health check fails too, so docker marks it unhealthy, while PostgreSQL itself is up",
      "the traffic's clients retry and give up: many payments end with their outcome unknown, and arrivals past 64 in flight are shed",
      "the money check passes: a payment that never got a connection was never charged, and one charged before its answer was lost is confirmed by its webhook"
    ],
    "expected_money": {
      "during": "passed",
      "after": "passed",
      "quiet": "passed"
    },
    "remedy": "roll the payments API back to REFUND_CONNECTION=returned: its new container starts with a full pool"
  },
