  "fault": {
    "name": "poison-message",
    "title": "The ledger stops booking: a poison message",
    "cause": "a deploy of the ledger consumer that retries unreadable messages forever (BAD_EVENTS=retry), then one unreadable event from the provider (a payment.updated with its amount as a decimal string): the ledger consumer is stuck on it, and books nothing behind it",
    "expected_symptoms": [
      "the ledger's lag climbs on every partition: one consumer reads all three, and it is stuck on that one message (head-of-line blocking); the payment confirmer keeps up",
      "the ledger's retries climb, with 'could not book; will retry the same message' errors for one offset",
      "the confirmer dead-letters the same event as unreadable; the ledger never does",
      "the ledger consumer turns unhealthy: its heartbeat stops while it retries",
      "the money check cannot settle (exit 2); without waiting, the events behind the poison look lost"
    ],
    "expected_money": {
      "during": "could not run",
      "after": "passed",
      "quiet": "passed"
    },
    "remedy": "roll the ledger consumer back to dead-lettering: the poison goes to the dead-letter topic, the backlog drains, and the money check passes again"
  },
